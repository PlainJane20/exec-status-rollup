# Jira credentials — leave these blank to fall back to reading them from
# ../pm-automation-system/.env instead (see config.py). Fill these in only
# if you want this tool to use its own separate Jira credentials.
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=PGMAUTO

ANTHROPIC_API_KEY=sk-ant-...

# Optional — post the rollup into a Slack channel (reuses the same
# chat:write pattern as slack-daily-agent)
SLACK_USER_TOKEN=
